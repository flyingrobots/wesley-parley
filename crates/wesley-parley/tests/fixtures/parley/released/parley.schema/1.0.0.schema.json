{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/parley/schemas/parley.schema/1.0.0",
  "title": "parley schema",
  "description": "One message schema, carried by --schema and --help (spec \u00a74.1, \u00a74.2).",
  "type": "object",
  "required": [
    "event",
    "t",
    "seq",
    "run",
    "id",
    "version",
    "schema",
    "_schema"
  ],
  "properties": {
    "event": {
      "const": "schema"
    },
    "t": {
      "type": "integer",
      "minimum": 0,
      "description": "POSIX time in milliseconds (spec \u00a71.3)."
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "The run's single counter (spec \u00a71.3)."
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "description": "The execution this line belongs to (spec \u00a72.1)."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "schema": {
      "type": "object",
      "description": "The JSON Schema document for that exact (id, version)."
    },
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "parley.schema"
        },
        "version": {
          "const": "1.0.0",
          "description": "Full validation is against the schema for this exact id and version (spec \u00a74.5, \u00a74.6)."
        }
      }
    }
  }
}
